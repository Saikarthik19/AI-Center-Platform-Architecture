# ==========================================================
# AI Center - Environment Configuration Template
# ==========================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/aicenter?schema=public"

# Security & Encryption (AES-256-GCM Master Key - exactly 64 hex characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Authentication Session Secret
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-key-at-least-32-chars"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Server-wide Fallback Provider Keys (For shared demo mode)
# Users can always bring their own keys in the API Key Center
GOOGLE_GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""
CLOUDFLARE_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
HUGGINGFACE_API_KEY=""
